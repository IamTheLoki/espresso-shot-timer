# ESPHome Secrets File (template)
#
# 1. Rename this file to `secrets.yaml`
# 2. Replace all values below with your own
# 3. NEVER commit or share `secrets.yaml` (it is listed in .gitignore)

# Your WiFi (2.4 GHz)
wifi_ssid: "YourNetwork"
wifi_password: "YourPassword"

# API encryption key for Home Assistant.
# Generate a new one with: openssl rand -base64 32
api_key: "GenerateYourOwnKeyWithOpenSSL"

# OTA update password (for WiFi updates after the first flash)
ota_password: "ChooseAnOtaPassword"

# Fallback hotspot password (when WiFi is not reachable, min. 8 characters)
ap_password: "ChooseAnApPassword"
